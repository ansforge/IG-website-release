       fhir:ElementDefinition.short [ fhir:value "'NH' pour les patients identifiés par leur INS, 'PI' pour les patients identifiés par d'autres identifiants." ] ;
       fhir:ElementDefinition.definition [ fhir:value "'NH' pour les patients identifiés par leur INS, 'PI' pour les patients identifiés par d'autres identifiants." ] ;
