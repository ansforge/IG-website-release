         fhir:Reference.reference [ fhir:value "StructureDefinition/xdmreferenceId" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "XDM referenceIdList" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Modèle logique de referenceIdList.\nCette métadonnée contient une liste d'un ou plusieurs identifiant(s) d'objet(s) associé(s) au document.Liste d'éléments de type CX du standard HL7 v2.5." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "LogicalModelXDM" ]
     ], [
