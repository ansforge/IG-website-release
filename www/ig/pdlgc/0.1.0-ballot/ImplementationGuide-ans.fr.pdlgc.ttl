       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Modèle logique d'une association IHE XDS entre deux objets de l'archive de portabilité.\nPermet de relier un SubmissionSet ou un DocumentEntry à un autre (remplacement ou transformation)." ] ;
