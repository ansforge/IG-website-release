       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "XDM AuthorSubmissionSet" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Modèle logique d'un auteur d'un lot de soumission\nCette métadonnée représente les personnes physiques et/ou les systèmes auteurs d’un lot de soumission. \nConstituée des sous-attributs **authorInstitution**, **authorPerson**, **authorRole** et **authorSpecialty**, elle ne porte pas de valeur par elle-même." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "LogicalModelXDM" ]
