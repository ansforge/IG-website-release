      <definition value="L'archive de Portabilité est un conteneur structuré, regroupant l'ensemble des documents et données LGC exportées ainsi que les éléments de métadonnées, d'index et de documentation nécessaires à leur exploitation par le destinataire."/>
      <comment value="Transaction ExportArchivePortabilite"/>
      <min value="0"/>
      <max value="*"/>
