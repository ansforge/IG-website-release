  </contact>
  <description value="Modèle logique d'un auteur d'un lot de soumission&#xA;Cette métadonnée représente les personnes physiques et/ou les systèmes auteurs d’un lot de soumission. &#xA;Constituée des sous-attributs **authorInstitution**, **authorPerson**, **authorRole** et **authorSpecialty**, elle ne porte pas de valeur par elle-même. "/>
  <jurisdiction>
    <coding>
      <system value="urn:iso:std:iso:3166"/>
      <code value="FR"/>
      <display value="France (la)"/>
    </coding>
  </jurisdiction>
  <fhirVersion value="4.0.1"/>
  <kind value="logical"/>
  <abstract value="false"/>
  <type value="https://interop.esante.gouv.fr/ig/pdlgc/StructureDefinition/xdmAuthorSubmissionSet"/>
  <baseDefinition value="https://interop.esante.gouv.fr/ig/pdlgc/StructureDefinition/xdmAuthor|0.1.0-ballot"/>
  <derivation value="specialization"/>
  <snapshot>
    <extension url="http://hl7.org/fhir/tools/StructureDefinition/snapshot-base-version">
      <valueString value="0.1.0-ballot"/>
    </extension>
    <element id="xdmAuthorSubmissionSet">
      <path value="xdmAuthorSubmissionSet"/>
      <short value="XDM AuthorSubmissionSet"/>
      <definition value="Modèle logique d'un auteur d'un lot de soumission&#xA;Cette métadonnée représente les personnes physiques et/ou les systèmes auteurs d’un lot de soumission. &#xA;Constituée des sous-attributs **authorInstitution**, **authorPerson**, **authorRole** et **authorSpecialty**, elle ne porte pas de valeur par elle-même. "/>
      <min value="0"/>
      <max value="*"/>
      <base>
        <path value="Base"/>
        <min value="0"/>
        <max value="*"/>
      </base>
      <isModifier value="false"/>
    </element>
    <element id="xdmAuthorSubmissionSet.institution">
      <path value="xdmAuthorSubmissionSet.institution"/>
      <short value="Cette métadonnée représente la structure émettrice du lot de soumission"/>
      <definition value="Cet attribut représente la structure de l’auteur."/>
      <min value="0"/>
      <max value="1"/>
      <base>
        <path value="xdmAuthor.institution"/>
        <min value="0"/>
        <max value="1"/>
      </base>
      <type>
        <code value="https://interop.esante.gouv.fr/ig/pdlgc/StructureDefinition/xdmAuthorInstitution"/>
      </type>
    </element>
    <element id="xdmAuthorSubmissionSet.person[x]">
      <path value="xdmAuthorSubmissionSet.person[x]"/>
      <short value="Cette métadonnée représente la personne physique ou le système émetteur du lot de soumission.Pour les documents d’expression personnelle du patient, cette métadonnée fait référence au patient."/>
      <definition value="Author"/>
      <min value="1"/>
      <max value="1"/>
      <base>
        <path value="xdmAuthor.person[x]"/>
        <min value="1"/>
        <max value="1"/>
      </base>
      <type>
        <code value="https://interop.esante.gouv.fr/ig/pdlgc/StructureDefinition/xdmActorPs"/>
      </type>
      <type>
        <code value="https://interop.esante.gouv.fr/ig/pdlgc/StructureDefinition/xdmActorPatient"/>
      </type>
      <type>
        <code value="https://interop.esante.gouv.fr/ig/pdlgc/StructureDefinition/xdmActorSystem"/>
      </type>
    </element>
    <element id="xdmAuthorSubmissionSet.role">
      <path value="xdmAuthorSubmissionSet.role"/>
      <short value="Cette métadonnée représente le rôle joué par l’auteur vis-à-vis du patient lors de la constitution du lot de soumission, c'est-à-dire à quel titre l’auteur est intervenu vis-à-vis du patient (ex : médecin traitant, Responsable de l'admission, Membre de l'équipe de soins, etc.)."/>
      <definition value="**Author Role**"/>
      <min value="0"/>
      <max value="*"/>
      <base>
        <path value="xdmAuthor.role"/>
        <min value="0"/>
        <max value="*"/>
      </base>
      <type>
        <code value="CodeableConcept"/>
      </type>
      <binding>
        <strength value="preferred"/>
        <valueSet value="https://mos.esante.gouv.fr/NOS/JDV_J47-FunctionCode-CISIS/FHIR/JDV-J47-FunctionCode-CISIS|20250523120000"/>
      </binding>
    </element>
    <element id="xdmAuthorSubmissionSet.specialty">
      <path value="xdmAuthorSubmissionSet.specialty"/>
      <short value="Cet attribut représente la profession éventuellement associée au savoir-faire de l’auteur professionnel caractérisé par sa profession ou la profession associée au genre d’activité pour l’auteur professionnel caractérisé par son rôle."/>
      <definition value="**AutorSpecialty**"/>
      <min value="0"/>
      <max value="1"/>
      <base>
        <path value="xdmAuthor.specialty"/>
        <min value="0"/>
        <max value="1"/>
      </base>
      <type>
        <code value="CodeableConcept"/>
      </type>
      <binding>
        <strength value="preferred"/>
        <valueSet value="https://mos.esante.gouv.fr/NOS/JDV_J01-XdsAuthorSpecialty-CISIS/FHIR/JDV-J01-XdsAuthorSpecialty-CISIS|20260928120000"/>
      </binding>
    </element>
  </snapshot>
