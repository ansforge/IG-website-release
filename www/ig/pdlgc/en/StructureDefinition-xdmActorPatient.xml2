      <short value="Valeur de Universal ID type (ID). Valeur fixée à 'ISO'"/>
      <definition value="Valeur de Universal ID type (ID). Valeur fixée à 'ISO'"/>
      <min value="1"/>
      <max value="1"/>
      <base>
